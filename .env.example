# ---------------------------------------------------------------------------
# RailMon configuration. Copy to .env and fill in. Generate secrets with:
#   /opt/railmon/venv/bin/python -m railmon.genkeys
# ---------------------------------------------------------------------------

# Flask session signing key (long random string)
SECRET_KEY=change-me
# Fernet key (urlsafe base64 of 32 random bytes) used to encrypt PNRs/snapshots.
# BACK THIS UP: if it is lost, stored PNRs cannot be decrypted.
DATA_ENCRYPTION_KEY=change-me
# Key for the HMAC lookup hash of PNR numbers
PNR_HASH_KEY=change-me
# Shared secret for internal service-to-service REST calls (header X-Internal-Token)
INTERNAL_API_TOKEN=change-me

# MySQL (PyMySQL driver) - connection pool sizes below
DATABASE_URL=mysql+pymysql://railmon:CHANGE_DB_PASSWORD@127.0.0.1:3306/railmon?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (cache, de-duplication locks, rate limiting)
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@127.0.0.1:6379/0

# Outbound HTTP etiquette - identify yourself with a real contact address
HTTP_USER_AGENT=RailMon/1.0 (self-hosted railway monitor; contact: you@example.com)
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.5
RESPECT_ROBOTS_TXT=true
HTTP_EXTRA_CIPHERS=AES128-GCM-SHA256:AES256-GCM-SHA384

# Cache TTLs (seconds) - identical requests within the TTL are served from Redis
CACHE_TTL_TRAIN_STATUS=240
CACHE_TTL_STATION_BOARD=240
CACHE_TTL_PNR=600
CACHE_TTL_DISRUPTIONS=3600
CACHE_TTL_STATIC=86400

# PNR monitoring limits
PNR_MIN_CHECK_INTERVAL_MINUTES=30
CHART_MIN_CHECK_INTERVAL_MINUTES=15
PNR_MAX_CHECKS_PER_RUN=20
PNR_MAX_SAVED_PER_USER=25
PNR_ENQUIRIES_PER_USER_PER_HOUR=30
PNR_RETENTION_DAYS_AFTER_JOURNEY=7

# Retention / display
LOG_RETENTION_DAYS=30
LIVE_STATUS_RETENTION_DAYS=90
DELAY_THRESHOLD_MINUTES=15
STALE_AFTER_MINUTES=15
TIMEZONE=Asia/Kolkata

# Require login for the public railway pages too (PNR pages always require login)
LOGIN_REQUIRED_FOR_PUBLIC_PAGES=false
# Set to true when served over HTTPS (recommended)
SESSION_COOKIE_SECURE=false

# Optional overrides
# SCHEDULER_CONFIG_PATH=/opt/railmon/app/config/scheduler.yaml
# SOURCES_CONFIG_PATH=/opt/railmon/app/config/sources.yaml
# ADAPTER_MODULES=my_adapters
